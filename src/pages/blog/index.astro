---
import SiteLayout from '../../layouts/SiteLayout.astro';
import config from '../../../config.json';
import { getPosts, formatarData, srcsetCdn } from '../../lib/blog';

const posts = getPosts();
const title = 'Blog | CasaNós';
const description = 'Dicas e inspirações para planejar casamentos, eventos corporativos e celebrações em meio à natureza, em Valinhos (SP).';
const canonical = `https://${config.domain}/blog`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog CasaNós',
  description,
  url: canonical,
  inLanguage: 'pt-BR',
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, datePublished: p.date, image: p.image, url: `${canonical}/${p.slug}` })),
};
---
<SiteLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} active="blog">
  <section class="secao blog-lista">
    <div class="c">
      <div class="blog-cab">
        <svg class="onda" viewBox="0 0 70 42" aria-hidden="true"><use href="#onda" /></svg>
        <h1 class="titulo-secao">Histórias e dicas para celebrar</h1>
        <p>Ideias e orientações para planejar casamentos, eventos corporativos e encontros em meio à natureza.</p>
      </div>

      {posts.length === 0 ? (
        <p class="blog-vazio">Em breve, novidades por aqui.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((p, n) => {
            const d = formatarData(p.date);
            return (
              <article class="blog-card">
                <a class="blog-card__img" href={`/blog/${p.slug}`} tabindex="-1" aria-hidden="true">
                  <img loading={n < 3 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : undefined} decoding="async" src={p.image} srcset={srcsetCdn(p.image)} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw" width="1200" height="1020" alt="" />
                  <span class="blog-card__tag">{p.category}</span>
                  <span class="blog-card__data"><strong>{d.dia}</strong>{d.mes}</span>
                </a>
                <div class="blog-card__corpo">
                  <h2><a href={`/blog/${p.slug}`}>{p.title}</a></h2>
                  <p>{p.description}</p>
                  <a class="botao botao-linha botao-p" href={`/blog/${p.slug}`} aria-label={`Ler mais: ${p.title}`}>Ler mais</a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</SiteLayout>
