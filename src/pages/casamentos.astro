---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import LeadForm from '../components/LeadForm.astro';
import config from '../../config.json';
import '../styles/casanos-base.css';
import '../styles/casamentos.css';

const cdn = config.media.cdn_base;
const photos = `${cdn}/photos`;
const fonts = `${cdn}/fonts`;
// placeholders do design (DDD de Valinhos) sobre o padrão do preset
const ph = { telefone: '(19) 90000-0000', email: 'seu@email.com', convidados: 'Ex.: 100' };

const title = 'Casamentos em Valinhos | CasaNós';
const description = 'Celebre seu casamento em meio à natureza, na CasaNós, em Valinhos (SP): ambientes acolhedores, gastronomia autoral do Chef Lucas Vieira e cenários que tornam cada momento único.';
const canonical = `https://${config.domain}/casamentos`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: 'CasaNós',
  description,
  url: canonical,
  image: `${photos}/hero-1600.webp`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Dr. Antônio Bento Ferraz, 500',
    addressLocality: 'Valinhos',
    addressRegion: 'SP',
    postalCode: '13278-160',
    addressCountry: 'BR',
  },
};
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${photos}/hero-1600.webp`}
  theme="light"
  jsonLd={jsonLd}
  favicon={`${photos}/favicon.webp`}
  faviconSvg={`${photos}/favicon.svg`}
  appleTouchIcon={`${photos}/apple-touch-icon.webp`}
>
  <Fragment slot="head">
    <meta name="theme-color" content="#F4ECE1" />
    <!-- LCP: preload que casa com o <picture> do hero (celular x computador) -->
    <link rel="preload" as="image" type="image/webp" href={`${photos}/hero-celular.webp`} media="(max-width: 560px)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" href={`${photos}/hero-1600.webp`} imagesrcset={`${photos}/hero-1600.webp 1600w, ${photos}/hero-2560.webp 2560w`} imagesizes="(max-width: 767px) 240vw, 115vw" media="(min-width: 561px)" fetchpriority="high" />
    <link rel="preload" href={`${fonts}/Franie-Light.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${fonts}/ClarityCity-Light.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </Fragment>

  <Sprite />

  <main>
<!-- ===================== HERO — composição do KV + formulário (1ª dobra) ===================== -->
<section id="topo" class="hero">
  <figure class="hero-foto">
    <!-- foto em alta (ampliada 2x e tratada): WebP com JPEG de reserva; no celular, um recorte do centro -->
    <picture>
      <source media="(max-width: 560px)" type="image/webp" srcset={`${photos}/hero-celular.webp`}>
      <source type="image/webp" srcset={`${photos}/hero-1600.webp 1600w, ${photos}/hero-2560.webp 2560w`} sizes="(max-width: 767px) 240vw, 115vw">
      <img src={`${photos}/hero-1600.webp`} srcset={`${photos}/hero-1600.webp 1600w, ${photos}/hero-2560.webp 2560w`} sizes="(max-width: 767px) 240vw, 115vw" alt="Cerimônia montada à beira do lago, com corredor florido e o coreto ao fundo" width="2560" height="1435" fetchpriority="high">
    </picture>
  </figure>
  <div class="hero-cena">
    <div class="hero-cabeca">
      <div class="hero-texto">
        <div class="hero-titulo">
          <img class="hero-logo" src={`${photos}/logo-casanos.svg`} alt="CasaNós" width="83" height="170">
          <span class="hero-divisor" aria-hidden="true"></span>
          <h1 class="ajusta">Um espaço à&nbsp;altura<br class="br-d"> da<br class="br-m"> sua&nbsp;história</h1>
        </div>
        <p class="texto">Celebre seu&nbsp;casamento <span class="nowrap">em&nbsp;meio à&nbsp;natureza</span>, com&nbsp;ambientes acolhedores, gastronomia autoral e&nbsp;cenários que&nbsp;tornam cada&nbsp;momento&nbsp;único.</p>
      </div>
    </div>
    <div class="hero-form">
      <div class="cartao cartao-barra">
        <LeadForm formId="lead-form-hero" variant="barra" idPrefix="form-field-hero-" defaultTipo="Casamento" placeholders={ph} />
      </div>
    </div>
  </div>
</section>

<!-- ===================== AUTORIDADE ===================== -->
<section id="autoridade" class="autoridade" aria-label="Diferenciais da CasaNós">
  <div class="wrap">
    <ul class="fatos aparece">
      <li><span>Desde<br class="br-fato"> 1983</span></li>
      <li><span>Melhor localização<br class="br-fato"> do&nbsp;interior de&nbsp;SP</span></li>
      <li><span>Natureza<br class="br-fato"> exuberante</span></li>
    </ul>
  </div>
  <!-- celular: os mesmos diferenciais em uma faixa que corre devagar (a lista acima continua para leitores de tela) -->
  <div class="letreiro" aria-hidden="true"><div class="letreiro-trilho"><div class="letreiro-grupo"><span>Desde 1983</span><svg viewBox="0 0 70 42" aria-hidden="true"><use href="#onda"/></svg><span>Melhor localização do&nbsp;interior de&nbsp;SP</span><svg viewBox="0 0 70 42" aria-hidden="true"><use href="#onda"/></svg><span>Natureza exuberante</span><svg viewBox="0 0 70 42" aria-hidden="true"><use href="#onda"/></svg></div><div class="letreiro-grupo"><span>Desde 1983</span><svg viewBox="0 0 70 42" aria-hidden="true"><use href="#onda"/></svg><span>Melhor localização do&nbsp;interior de&nbsp;SP</span><svg viewBox="0 0 70 42" aria-hidden="true"><use href="#onda"/></svg><span>Natureza exuberante</span><svg viewBox="0 0 70 42" aria-hidden="true"><use href="#onda"/></svg></div></div></div>
</section>

<!-- ===================== CONCEITO ===================== -->
<section id="conceito" class="secao conceito">
  <div class="wrap">
    <div class="topo-secao">
      <svg viewBox="0 0 70 42" class="onda aparece" aria-hidden="true"><use href="#onda"/></svg>
      <h2 class="aparece">Propósito em<br class="br-p"> <span class="nowrap">receber e&nbsp;acolher</span></h2>
    </div>
    <div class="conceito-corpo">
      <figure class="foto conceito-foto aparece"><img src={`${photos}/conceito.webp`} alt="Casa histórica amarela da CasaNós, com a capela ao lado e o pátio de pedra" width="1600" height="900" loading="lazy"></figure>
      <div class="conceito-texto">
        <p class="texto aparece so-computador" style="--d:.08s">A&nbsp;CasaNós nasceu do&nbsp;encontro entre duas histórias&nbsp;e&nbsp;do&nbsp;desejo de&nbsp;aproximar pessoas. Em&nbsp;uma&nbsp;propriedade familiar com&nbsp;raízes desde 1983, natureza, família e&nbsp;fé se&nbsp;encontram em&nbsp;um&nbsp;mesmo propósito: receber com&nbsp;carinho, celebrar o&nbsp;amor e&nbsp;criar experiências que&nbsp;permanecem na&nbsp;memória. Mais&nbsp;do&nbsp;que&nbsp;um&nbsp;espaço para&nbsp;eventos, a&nbsp;CasaNós é&nbsp;um&nbsp;convite para&nbsp;reunir pessoas, fortalecer laços e&nbsp;celebrar as&nbsp;histórias que&nbsp;merecem ser&nbsp;vividas.</p>
        <!-- celular: versão resumida do mesmo texto -->
        <p class="texto aparece so-celular" style="--d:.08s">A&nbsp;CasaNós nasceu do&nbsp;encontro <span class="nowrap">entre duas&nbsp;histórias.</span><br> <span class="nowrap">Em uma propriedade familiar</span><br> <span class="nowrap">desde 1983, natureza, família</span><br> <span class="nowrap">e fé se unem</span> <span class="nowrap">em um só&nbsp;propósito:</span><br> <span class="nowrap">receber com&nbsp;carinho</span> <span class="nowrap">e celebrar o&nbsp;amor.</span></p>
        <p class="texto aparece" style="--d:.14s">A&nbsp;CasaNós está em&nbsp;uma&nbsp;região privilegiada de&nbsp;Valinhos, logo após o&nbsp;portal de&nbsp;entrada da&nbsp;cidade. Cercada pelo&nbsp;verde, oferece tranquilidade e&nbsp;privacidade sem&nbsp;abrir mão da&nbsp;praticidade: fica a&nbsp;cerca de <span class="nowrap">5&nbsp;minutos</span> de&nbsp;Vinhedo, <span class="nowrap">15&nbsp;minutos</span> de&nbsp;Campinas e <span class="nowrap">25&nbsp;minutos</span> do&nbsp;Aeroporto de&nbsp;Viracopos, com&nbsp;fácil acesso para&nbsp;quem vem de&nbsp;São&nbsp;Paulo ou&nbsp;pela Rodovia Anhanguera.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== GALERIA ===================== -->
<section id="galeria" class="secao galeria">
  <div class="wrap">
    <div class="topo-secao">
      <svg viewBox="0 0 70 42" class="onda aparece" aria-hidden="true"><use href="#onda"/></svg>
      <h2 class="aparece">Descubra<br class="br-m"> os<br class="br-d"> cenários<br class="br-m"> da&nbsp;CasaNós</h2>
    </div>
  </div>
  <div class="galeria-trilho" id="galeria-trilho" data-lenis-prevent-horizontal>
    <button type="button" class="galeria-item" style="--ar:16/9"><img src={`${photos}/galeria_01.webp`} alt="Cerimônia ao entardecer sob árvores iluminadas, com corredor de flores brancas e o coreto ao fundo" width="1673" height="940" loading="lazy"></button>
    <button type="button" class="galeria-item" style="--ar:16/9"><img src={`${photos}/galeria_06.webp`} alt="Salão com mesa de buffet, flores, velas e portas de vidro abertas para a área externa" width="1672" height="941" loading="lazy"></button>
    <button type="button" class="galeria-item" style="--ar:16/9"><img src={`${photos}/galeria_05.webp`} alt="Construção térrea amarela com pérgola florida sob uma grande árvore" width="1280" height="720" loading="lazy"></button>
    <button type="button" class="galeria-item" style="--ar:16/9"><img src={`${photos}/galeria_04.webp`} alt="Pérgola com buganvílias ao longo da casa amarela, com o logo da CasaNós na fachada" width="1280" height="720" loading="lazy"></button>
    <button type="button" class="galeria-item" style="--ar:16/9"><img src={`${photos}/galeria_03.webp`} alt="Área externa coberta com toldos de lona, ao lado da casa amarela da CasaNós" width="1280" height="720" loading="lazy"></button>
    <button type="button" class="galeria-item" style="--ar:16/9"><img src={`${photos}/galeria_02.webp`} alt="Banheiro com bancada de madeira, cubas de cerâmica e espelhos redondos pendurados" width="1280" height="720" loading="lazy"></button>
  </div>
  <div class="wrap galeria-controles">
    <button type="button" class="seta" id="galeria-ant" aria-label="Fotos anteriores"><svg aria-hidden="true"><use href="#seta-esq"/></svg></button>
    <div class="galeria-progresso" aria-hidden="true"><span id="galeria-barra"></span></div>
    <button type="button" class="seta" id="galeria-prox" aria-label="Próximas fotos"><svg aria-hidden="true"><use href="#seta-dir"/></svg></button>
  </div>
</section>

<!-- ===================== ESPAÇOS ===================== -->
<section id="espacos" class="secao espacos">
  <div class="wrap">
    <div class="topo-secao">
      <svg viewBox="0 0 70 42" class="onda aparece" aria-hidden="true"><use href="#onda"/></svg>
      <h2 class="aparece">A beleza de celebrar<br> em meio à&nbsp;natureza</h2>
    </div>
    <!-- celular: os nomes viram pílulas; a foto e a legenda do espaço escolhido aparecem abaixo -->
    <div class="espacos-abas" role="group" aria-label="Escolha o espaço">
      <button type="button" aria-pressed="true" aria-controls="espaco-1">Vista para o&nbsp;jardim e&nbsp;cerimônia ao&nbsp;ar&nbsp;livre</button>
      <button type="button" aria-pressed="false" aria-controls="espaco-2">Lago e coreto</button>
      <button type="button" aria-pressed="false" aria-controls="espaco-3">Pergolado e capela</button>
      <button type="button" aria-pressed="false" aria-controls="espaco-4">Área da piscina</button>
      <button type="button" aria-pressed="false" aria-controls="espaco-5">Salão climatizado</button>
      <button type="button" aria-pressed="false" aria-controls="espaco-6">Área externa</button>
      <button type="button" aria-pressed="false" aria-controls="espaco-7">Fire pit</button>
    </div>
    <ul class="espacos-lista aparece" id="espacos-lista">
      <li class="espaco ativo">
        <figure class="foto"><img src={`${photos}/espaco-jardim.webp`} alt="Cerimônia ao ar livre no jardim, com cadeiras e corredor de flores brancas" width="1600" height="900" loading="lazy"></figure>
        <div class="espaco-detalhe" id="espaco-1"><p class="espaco-nome" aria-hidden="true">Vista para o&nbsp;jardim e&nbsp;cerimônia ao&nbsp;ar&nbsp;livre</p><p class="espaco-leg">Um&nbsp;cenário natural para&nbsp;celebrar a&nbsp;união.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="true" aria-controls="espaco-1"><span class="espaco-num" aria-hidden="true">01</span><span>Vista para o&nbsp;jardim e&nbsp;cerimônia ao&nbsp;ar&nbsp;livre</span></button></h3>
      </li>
      <li class="espaco">
        <figure class="foto"><img src={`${photos}/espaco-lago-coreto.webp`} alt="Lago com coreto e cerimônia montada às margens" width="900" height="1600" loading="lazy" style="object-position:50% 44%"></figure>
        <div class="espaco-detalhe" id="espaco-2"><p class="espaco-nome" aria-hidden="true">Lago e&nbsp;coreto</p><p class="espaco-leg">Elementos que&nbsp;acrescentam personalidade à&nbsp;celebração.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="false" aria-controls="espaco-2"><span class="espaco-num" aria-hidden="true">02</span><span>Lago e&nbsp;coreto</span></button></h3>
      </li>
      <li class="espaco">
        <figure class="foto"><img src={`${photos}/espaco-pergolado-capela.webp`} alt="Corredor florido sob o pergolado, com a capela ao fundo" width="900" height="1600" loading="lazy" style="object-position:50% 32%"></figure>
        <div class="espaco-detalhe" id="espaco-3"><p class="espaco-nome" aria-hidden="true">Pergolado e&nbsp;capela</p><p class="espaco-leg">Ambiente único para&nbsp;cerimônias intimistas.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="false" aria-controls="espaco-3"><span class="espaco-num" aria-hidden="true">03</span><span>Pergolado e&nbsp;capela</span></button></h3>
      </li>
      <li class="espaco">
        <figure class="foto"><img src={`${photos}/espaco-piscina.webp`} alt="Área da piscina cercada por árvores e balaustrada branca" width="1600" height="900" loading="lazy" style="object-position:42% 50%"></figure>
        <div class="espaco-detalhe" id="espaco-4"><p class="espaco-nome" aria-hidden="true">Área da&nbsp;piscina</p><p class="espaco-leg">Área externa que&nbsp;pode receber <span class="nowrap">lounges e&nbsp;pista de&nbsp;dança</span>.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="false" aria-controls="espaco-4"><span class="espaco-num" aria-hidden="true">04</span><span>Área da&nbsp;piscina</span></button></h3>
      </li>
      <li class="espaco">
        <figure class="foto"><img src={`${photos}/espaco-salao.webp`} alt="Salão climatizado com mesa de buffet, flores e portas de vidro para o jardim" width="900" height="1600" loading="lazy" style="object-position:50% 52%"></figure>
        <div class="espaco-detalhe" id="espaco-5"><p class="espaco-nome" aria-hidden="true">Salão climatizado</p><p class="espaco-leg">Espaço interno integrado às áreas externas, com&nbsp;capacidade para&nbsp;até&nbsp;100&nbsp;convidados sentados.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="false" aria-controls="espaco-5"><span class="espaco-num" aria-hidden="true">05</span><span>Salão climatizado</span></button></h3>
      </li>
      <li class="espaco">
        <figure class="foto"><img src={`${photos}/espaco-area-externa.webp`} alt="Área externa com mesa posta diante da casa amarela" width="1600" height="900" loading="lazy" style="object-position:50% 62%"></figure>
        <div class="espaco-detalhe" id="espaco-6"><p class="espaco-nome" aria-hidden="true">Área externa</p><p class="espaco-leg">200&nbsp;m² para&nbsp;ampliar as&nbsp;possibilidades de&nbsp;recepção e&nbsp;convivência.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="false" aria-controls="espaco-6"><span class="espaco-num" aria-hidden="true">06</span><span>Área externa</span></button></h3>
      </li>
      <li class="espaco">
        <figure class="foto"><img src={`${photos}/galeria-12.webp`} alt="Fire pit aceso entre as árvores, com cadeiras ao redor e caminho de pedriscos" width="1200" height="2131" loading="lazy" style="object-position:50% 62%"></figure>
        <div class="espaco-detalhe" id="espaco-7"><p class="espaco-nome" aria-hidden="true">Fire pit</p><p class="espaco-leg">Um&nbsp;cenário acolhedor para&nbsp;celebrar o&nbsp;amor e&nbsp;reunir pessoas especiais ao&nbsp;redor da&nbsp;fogueira.</p></div>
        <h3><button type="button" class="espaco-botao" aria-expanded="false" aria-controls="espaco-7"><span class="espaco-num" aria-hidden="true">07</span><span>Fire pit</span></button></h3>
      </li>
    </ul>
    <div class="espacos-progresso" aria-hidden="true"><span id="espacos-barra"></span></div>
  </div>
</section>

<!-- ===================== GASTRONOMIA ===================== -->
<section id="gastronomia" class="secao gastronomia">
  <div class="wrap">
    <div class="topo-secao">
      <svg viewBox="0 0 70 42" class="onda aparece" aria-hidden="true"><use href="#onda"/></svg>
      <h2 class="aparece">Gastronomia<br class="br-m"> que também<br class="br-d"> faz<br class="br-m"> parte da&nbsp;história</h2>
      <p class="texto aparece linhas-cel" style="--d:.08s"><span class="l">Sob a&nbsp;assinatura do <span class="nome">Chef&nbsp;Lucas&nbsp;Vieira</span>,</span> <span class="l">a&nbsp;cozinha é&nbsp;autoral e&nbsp;afetiva, com</span> <span class="l">influências portuguesas e&nbsp;espanholas.</span> <span class="l">O&nbsp;cardápio é&nbsp;construído em</span> <span class="l">conjunto com&nbsp;os&nbsp;anfitriões.</span></p>
    </div>
    <div class="gastro-painel" id="gastro-painel">
      <button type="button" class="gastro-item aparece ativo" style="--d:0.00s" aria-label="Ampliar foto: Paella de carnes grelhadas servida na panela"><img src={`${photos}/gastronomia-01.webp`} alt="Paella de carnes grelhadas servida na panela" width="1600" height="900" loading="lazy"><span class="gastro-zoom" aria-hidden="true"><svg><use href="#ampliar"/></svg></span></button>
      <button type="button" class="gastro-item aparece" style="--d:0.06s" aria-label="Ampliar foto: Mesa de charcutaria com queijos, frutas e flores"><img src={`${photos}/gastronomia-02.webp`} alt="Mesa de charcutaria com queijos, frutas e flores" width="900" height="1600" loading="lazy" style="object-position:50% 58%"><span class="gastro-zoom" aria-hidden="true"><svg><use href="#ampliar"/></svg></span></button>
      <button type="button" class="gastro-item aparece" style="--d:0.12s" aria-label="Ampliar foto: Aperitivos dourados servidos em tábuas e pratos"><img src={`${photos}/gastronomia-03.webp`} alt="Aperitivos dourados servidos em tábuas e pratos" width="1600" height="900" loading="lazy"><span class="gastro-zoom" aria-hidden="true"><svg><use href="#ampliar"/></svg></span></button>
      <button type="button" class="gastro-item aparece" style="--d:0.18s" aria-label="Ampliar foto: Paella de frutos do mar colorida"><img src={`${photos}/gastronomia-04.webp`} alt="Paella de frutos do mar colorida" width="1600" height="900" loading="lazy"><span class="gastro-zoom" aria-hidden="true"><svg><use href="#ampliar"/></svg></span></button>
      <button type="button" class="gastro-item aparece" style="--d:0.24s" aria-label="Ampliar foto: Mesa farta de queijos e aperitivos"><img src={`${photos}/gastronomia-05.webp`} alt="Mesa farta de queijos e aperitivos" width="1600" height="900" loading="lazy"><span class="gastro-zoom" aria-hidden="true"><svg><use href="#ampliar"/></svg></span></button>
    </div>
    <div class="gastro-progresso" aria-hidden="true"><span id="gastro-barra"></span></div>
    <!-- celular: miniaturas para escolher a foto (cada seção da LP passa as fotos de um jeito) -->
    <div class="gastro-miniaturas" role="group" aria-label="Escolher foto da gastronomia">
      <button type="button" aria-pressed="true" aria-label="Mostrar foto: Paella de carnes grelhadas servida na panela"><img src={`${photos}/gastronomia-01.webp`} alt="" width="160" height="160" loading="lazy"></button>
      <button type="button" aria-pressed="false" aria-label="Mostrar foto: Mesa de charcutaria com queijos, frutas e flores"><img src={`${photos}/gastronomia-02.webp`} alt="" width="160" height="160" loading="lazy"></button>
      <button type="button" aria-pressed="false" aria-label="Mostrar foto: Aperitivos dourados servidos em tábuas e pratos"><img src={`${photos}/gastronomia-03.webp`} alt="" width="160" height="160" loading="lazy"></button>
      <button type="button" aria-pressed="false" aria-label="Mostrar foto: Paella de frutos do mar colorida"><img src={`${photos}/gastronomia-04.webp`} alt="" width="160" height="160" loading="lazy"></button>
      <button type="button" aria-pressed="false" aria-label="Mostrar foto: Mesa farta de queijos e aperitivos"><img src={`${photos}/gastronomia-05.webp`} alt="" width="160" height="160" loading="lazy"></button>
    </div>
    <div class="gastro-controles">
      <button type="button" class="seta" id="gastro-ant" aria-label="Foto anterior da gastronomia"><svg aria-hidden="true"><use href="#seta-esq"/></svg></button>
      <button type="button" class="seta" id="gastro-prox" aria-label="Próxima foto da gastronomia"><svg aria-hidden="true"><use href="#seta-dir"/></svg></button>
    </div>
  </div>
</section>

<!-- ===================== HOSPEDAGEM ===================== -->
<section id="hospedagem" class="secao hospedagem">
  <div class="wrap">
    <div class="hosp-corpo">
      <div class="hosp-texto">
        <svg viewBox="0 0 70 42" class="onda aparece" aria-hidden="true"><use href="#onda"/></svg>
        <h2 class="aparece">Cuidado<br class="br-m"> que vai além<br> da&nbsp;celebração</h2>
