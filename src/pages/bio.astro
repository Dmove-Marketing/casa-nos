---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import LeadForm from '../components/LeadForm.astro';
import config from '../../config.json';
import '../styles/casanos-base.css';
import '../styles/bio.css';

const cdn = config.media.cdn_base;
const photos = `${cdn}/photos`;
const fonts = `${cdn}/fonts`;
const ph = { telefone: '(19) 90000-0000', email: 'seu@email.com', convidados: 'Ex.: 100' };

const title = 'CasaNós | Casamentos e eventos em Valinhos';
const description = 'Celebre momentos extraordinários em um espaço cercado pela natureza.';
const canonical = `https://${config.domain}/bio`;

// Botões da bio. Quando o site estiver no ar, basta preencher `siteUrl`.
const siteUrl = '';
const enderecoUrl = 'https://www.google.com/maps/search/?api=1&query=Rua%20Dr.%20Ant%C3%B4nio%20Bento%20Ferraz%2C%20500%2C%20Valinhos%20-%20SP%2C%2013278-160';
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${photos}/hero-1600.webp`}
  theme="light"
  noIndex={true}
  favicon={`${photos}/favicon.webp`}
  faviconSvg={`${photos}/favicon.svg`}
  appleTouchIcon={`${photos}/apple-touch-icon.webp`}
>
  <Fragment slot="head">
    <meta name="theme-color" content="#E2D7C8" />
    <link rel="preload" as="image" type="image/webp" href={`${photos}/hero-celular.webp`} media="(max-width: 560px)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" href={`${photos}/hero-1600.webp`} media="(min-width: 561px)" fetchpriority="high" />
    <link rel="preload" href={`${fonts}/Franie-Light.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${fonts}/ClarityCity-Light.woff2`} as="font" type="font/woff2" crossorigin />
  </Fragment>

  <Sprite />

  <main>
    <section id="bio" class="bio">
      <figure class="bio-foto">
        <picture>
          <source media="(max-width: 560px)" type="image/webp" srcset={`${photos}/hero-celular.webp`} />
          <img
            src={`${photos}/hero-1600.webp`}
            srcset={`${photos}/hero-1600.webp 1600w, ${photos}/hero-2560.webp 2560w`}
            sizes="100vw"
            alt="Cerimônia montada à beira do lago, com corredor florido e o coreto ao fundo"
            width="2560"
            height="1435"
            fetchpriority="high"
          />
        </picture>
      </figure>

      <div class="bio-conteudo">
        <img class="bio-logo" src={`${photos}/logo-casanos.svg`} alt="CasaNós" width="83" height="170" />
        <h1>Um espaço para celebrar o que nos une</h1>

        <nav class="bio-botoes" aria-label="Links da CasaNós">
          <a class="btn btn-contorno bio-btn" href={enderecoUrl} target="_blank" rel="noopener" aria-label="Ver o endereço no Google Maps: Rua Dr. Antônio Bento Ferraz, 500, Bairro Dois Córregos, Valinhos – SP, CEP 13278-160">
            <svg viewBox="0 0 20 20" aria-hidden="true"><use href="#pino"></use></svg>
            Endereço
          </a>
          {siteUrl ? (
            <a class="btn btn-contorno bio-btn" href={siteUrl} target="_blank" rel="noopener">Site</a>
          ) : (
            <span class="btn btn-contorno bio-btn indisponivel" role="link" aria-disabled="true">
              Site <span class="bio-aviso">em breve</span>
            </span>
          )}
        </nav>

        <div class="cartao">
          <p class="cartao-titulo">Solicite orçamento</p>
          <LeadForm formId="lead-form-bio" preset="geral" variant="cartao" class="form-contato" placeholders={ph} />
        </div>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="wrap rodape-linha">
      <span class="rodape-logo"><img src={`${photos}/logo-casanos.svg`} alt="CasaNós" width="83" height="170" loading="lazy" /></span>
      <p class="rodape-direitos">Copyright © 2026 CasaNós<span class="rodape-traco"> -</span><br class="rodape-br" /> Todos os&nbsp;direitos reservados</p>
      <p class="rodape-credito">Desenvolvido por <a class="rodape-dmove" href="https://dmove.com.br" target="_blank" rel="noopener"><img src={`${photos}/logo-dmove.webp`} alt="Dmove" width="600" height="134" loading="lazy" /></a></p>
    </div>
  </footer>

  <script>
    import { initForms } from '../scripts/forms';
    import { initDateFields } from '../scripts/date-field';
    import { initConditionalFields } from '../scripts/conditional-fields';

    initConditionalFields();
    initDateFields();
    initForms();
  </script>
</Base>
